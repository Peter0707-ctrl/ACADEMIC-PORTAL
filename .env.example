# ==============================================================================
# UNIVERSAL EDUCATION MANAGEMENT PLATFORM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Environment
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
AI_SERVICE_PORT=8000

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/academic_portal?schema=public"

# Redis Cache and BullMQ Queue
REDIS_URL="redis://localhost:6379"

# Authentication & Security
JWT_SECRET="replace-with-a-very-secure-32-byte-hex-string-for-jwt-signing"
JWT_EXPIRATION="24h"
SESSION_SECRET="replace-with-a-very-secure-session-secret"

# Object Storage (S3 / MinIO for documents, report cards, templates)
OBJECT_STORAGE_ENDPOINT="http://localhost:9000"
OBJECT_STORAGE_BUCKET="academic-portal-documents"
OBJECT_STORAGE_ACCESS_KEY="minioadmin"
OBJECT_STORAGE_SECRET_KEY="minioadmin"
OBJECT_STORAGE_REGION="us-east-1"
OBJECT_STORAGE_USE_SSL="false"

# Communications & Notifications
EMAIL_PROVIDER="smtp" # smtp | sendgrid | ses
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="no-reply@academicportal.com"

SMS_PROVIDER="log" # log | twilio | africastalking
SMS_API_KEY=""
SMS_SENDER_ID="ACADEMIC"

# AI Service Integration
AI_SERVICE_URL="http://localhost:8000"
AI_SERVICE_SECRET="internal-service-secret-token"

# Frontend Configuration
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_APP_NAME="Universal Academic Portal"
