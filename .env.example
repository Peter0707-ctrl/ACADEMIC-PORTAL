# ==============================================================================
# ACADEMIC PORTAL — PRODUCTION & DEVELOPMENT ENVIRONMENT TEMPLATE
# Copy to .env and configure secret keys before running or deploying
# ==============================================================================

# NODE ENVIRONMENT
NODE_ENV=production

# APPLICATION PORTS
PORT=4000
API_PORT=4000
NEXT_PORT=3000

# POSTGRES DATABASE (Connects to Railway PostgreSQL Plugin or local container)
# Railway provides DATABASE_URL automatically when you add the PostgreSQL plugin
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/academic_portal?schema=public"

# REDIS CACHE & QUEUES (Connects to Railway Redis Plugin or local container)
# Railway provides REDIS_URL automatically when you add the Redis plugin
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=""

# SECURITY & AUTHENTICATION SECRETS (MANDATORY IN PRODUCTION)
# Generate a strong 64-char key using: openssl rand -base64 48
JWT_SECRET="CHANGE_ME_TO_A_VERY_STRONG_SECRET_KEY_FOR_PRODUCTION_64_CHARS"
JWT_EXPIRATION="24h"

# CORS ORIGINS (Comma-separated list of allowed web frontend URLs)
# Example: https://academic-portal.up.railway.app,https://my-school.ac.tz
CORS_ORIGIN="http://localhost:3000,http://127.0.0.1:3000"

# SWAGGER / OPENAPI DOCUMENTATION (true | false)
# Disabled by default in production for security; set to true if needed
ENABLE_SWAGGER=false

# NEXT.JS FRONTEND CONFIGURATION
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
