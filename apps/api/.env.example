# ==============================================================================
# ACADEMIC PORTAL — BACKEND API ENVIRONMENT TEMPLATE
# ==============================================================================

NODE_ENV=production
PORT=4000
API_PORT=4000

# Railway provides DATABASE_URL automatically when you add PostgreSQL plugin
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/academic_portal?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=""

# Security
JWT_SECRET="GENERATE_A_64_CHAR_KEY_FOR_PRODUCTION"
JWT_EXPIRATION="24h"

# CORS Allowed Origins
CORS_ORIGIN="http://localhost:3000,http://127.0.0.1:3000"

# Documentation
ENABLE_SWAGGER=false
